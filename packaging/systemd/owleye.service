[Unit]
Description=OwlEyeEngine - Enterprise Kernel Telemetry & Active Defense Daemon
Documentation=https://github.com/ExeDevCentral/OwlEyeEngine
After=network.target network-online.target sys-kernel-debug.mount
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/owleye
ExecStart=/usr/bin/python3 /opt/owleye/sentry.py
Restart=always
RestartSec=5s

# Process & File Hardening
ProtectHome=read-only
ProtectSystem=full
PrivateTmp=true

# Kernel & Network Capabilities for eBPF and nftables/iptables
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_BPF CAP_SYS_PTRACE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_BPF CAP_SYS_PTRACE

# Resource Limits
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=OWLEYE_PORT=8000
Environment=OWLEYE_DEMO_MODE=false

[Install]
WantedBy=multi-user.target
